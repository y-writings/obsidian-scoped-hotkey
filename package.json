		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"happy-dom": "^20.11.6",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"vitest": "^4.1.11"
	}
